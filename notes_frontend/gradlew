#!/usr/bin/env bash
set -euo pipefail

# Shim gradle wrapper for CI environments when android/ project is not yet generated.
# If android/ exists, delegate to the real wrapper. Otherwise, instruct the user/CI.
if [ -d "android" ] && [ -x "android/gradlew" ]; then
  exec ./android/gradlew "$@"
fi

echo "Gradle wrapper not found because the native Android project has not been generated."
echo "Run: npm run prebuild:android  (expo prebuild) to create the android/ folder."
echo "Skipping Gradle task in this environment."
# Exit 0 to avoid failing CI that probes Gradle before prebuild.
exit 0
