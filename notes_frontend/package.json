{
  "name": "reactnative",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android",
    "build:android": "bash ./scripts/guard-gradle.sh assembleDebug",
    "build": "npm run prebuild:android && npm run build:android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.4",
    "expo": "~53.0.20",
    "expo-linear-gradient": "~13.0.2",
    "expo-sqlite": "~15.0.7",
    "expo-status-bar": "~2.2.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.76.6",
    "react-native-web": "~0.19.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.71",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.40.0"
  },
  "private": true
}
